# 复制为 .env 后可按需修改。不要把密钥写入仓库；第一版不需要外部账号。
AERP_DATABASE_URL=sqlite:///data/aerp.db
AERP_AUTO_SEED=true
AERP_SEED_MAP_DEMO=false
AERP_WHO_CACHE_HOURS=24
AERP_DEMO_SEED=42
AERP_HOST=127.0.0.1
AERP_PORT=8000
AERP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AERP_SYNC_TASKS=false

# 本地研究操作者显示名（不是认证身份）
AERP_OPERATOR_NAME=local-researcher

# 真实 AI：密钥只放后端环境变量，不要写入前端。
# provider=openai_compat 使用官方 Chat Completions：POST {BASE}/chat/completions
# 模型名请按当前服务文档填写，例如 gpt-4.1-mini；不要臆测未公布的名称。
# AERP_AI_PROVIDER=openai_compat
# AERP_AI_BASE_URL=https://api.openai.com/v1
# AERP_AI_API_KEY=
# AERP_AI_MODEL=
# AERP_AI_TIMEOUT_SECONDS=60
# AERP_AI_MAX_RETRIES=2
# 仅测试允许 mock：
# AERP_AI_ALLOW_MOCK=false
